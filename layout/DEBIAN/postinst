#!/bin/sh
for prefix in "" /var/jb; do
    if [ -d "$prefix/Applications/GitHubLegacy.app" ] && [ -x "$prefix/usr/bin/uicache" ]; then
        su -c "$prefix/usr/bin/uicache -p $prefix/Applications/GitHubLegacy.app" mobile || "$prefix/usr/bin/uicache" -p "$prefix/Applications/GitHubLegacy.app"
    fi
done

exit 0
